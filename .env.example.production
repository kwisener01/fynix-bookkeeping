# Production Environment Variables
# Copy these to Railway/Render environment variables section

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Database
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# App Config
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=https://fynixbooks.com,https://www.fynixbooks.com

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# SendGrid (for emails)
SENDGRID_API_KEY=SG.your-key-here
FROM_EMAIL=noreply@fynixbooks.com

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-random-32-character-secret-here

# CORS
CORS_ORIGINS=["https://fynixbooks.com","https://www.fynixbooks.com"]
